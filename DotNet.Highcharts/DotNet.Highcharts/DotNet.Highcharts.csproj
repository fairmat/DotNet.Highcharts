<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net452;netstandard2.0;net8.0</TargetFrameworks>
    <AssemblyTitle>CareATC.DotNet.Highcharts</AssemblyTitle>
    <Company>Fairmat S.r.l;CareATC, Inc</Company>
    <Product>DotNet.Highcharts</Product>
    <Copyright>Copyright © 2012 Vangel Kolarov;Copyright © 2013 Fairmat SRL;Copyright © 2018 CareATC</Copyright>
    <Version>6.0.0</Version>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <AssemblyOriginatorKeyFile>DotNet.Highcharts.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <None Include="DotNet.Highcharts.snk" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Enums\Tickmarks.cs" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net452' ">
    <Reference Include="System.Web" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
    <PackageReference Include="System.Drawing.Primitives" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties" />
  </ItemGroup>
</Project>